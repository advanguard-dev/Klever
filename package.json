{
  "name": "klever",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "Local markdown vault — pages, databases, boards, and calendar on your disk.",
  "author": "Klever",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "type": "module",
  "bin": {
    "klever": "./cli/klever.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/advanguard-dev/Klever.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "npm run dev --prefix web",
    "build:web-site": "npm run build --prefix web",
    "dev:app": "electron .",
    "klever": "node cli/klever.mjs",
    "build:icon": "bash scripts/build-icon.sh",
    "build:web": "tsc --noEmit && vite build",
    "build": "npm run build:web",
    "build:beta": "npm run build:icon && npm run build:web && bash scripts/build-app.sh",
    "build:dmg": "npm run build:icon && npm run build:web && bash scripts/build-app.sh && bash scripts/create-dmg.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@moonshine-ai/moonshine-wasm": "^0.1.3",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-table-cell": "^3.30.1",
    "@tiptap/extension-table-header": "^3.30.1",
    "@tiptap/extension-table-row": "^3.30.1",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@types/katex": "^0.16.8",
    "@uiw/react-codemirror": "^4.25.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "katex": "^0.18.7",
    "lucide-react": "^0.539.0",
    "marked": "^18.0.9",
    "mermaid": "^11.17.2",
    "nanoid": "^5.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.8.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.klever.app",
    "productName": "Klever",
    "copyright": "Copyright © Klever",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Klever-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Klever ${version}",
      "icon": "build/icon.icns"
    }
  }
}
